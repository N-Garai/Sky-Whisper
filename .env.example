# SkyWhisper environment variables
# Copy to .env and fill in values. Never commit .env to git.

# TTS (optional — template narration works without this)
ELEVENLABS_API_KEY=
ELEVEN_VOICE_ID=pNInz6obpgDQGcFmaJgB

# LLM Provider: template | openai | gemma | ollama
#   template — deterministic narrator only (default, $0, zero external calls)
#   openai   — any model via an OpenAI-compatible endpoint (protocol name, not a vendor)
#   gemma    — alias for the Gemma path below (identical behaviour, clearer intent)
#   ollama   — local Ollama daemon (fully offline inference)
LLM_PROVIDER=template

# Gemma via an OpenAI-compatible endpoint (only if LLM_PROVIDER=openai|gemma).
# Key: free Google AI Studio key from https://aistudio.google.com/apikey
# Default model is the known-good Gemma 3 ID. Current-generation upgrade
# (documented hosted IDs — verify with your own key before demoing, as
# Google serves newer IDs over the native API and OpenAI-compat coverage
# of Gemma 4 IDs is unconfirmed):
# GEMMA_MODEL=gemma-4-26b-a4b-it
GEMMA_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMMA_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it

# Ollama (only if LLM_PROVIDER=ollama; LOCAL_INFERENCE=true is equivalent).
# Default tag runs anywhere; current-generation local alternative:
# ollama run gemma4:e2b  (then OLLAMA_MODEL=gemma4:e2b)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e2b

# Ephemeris kernel (downloaded once, cached under data/ephemeris/)
SKYWHISPER_EPHEMERIS=de421.bsp

# Server
PORT=8080

# Model fallback chain (first validated transcript wins; template is the last resort)
#   1. Gemini API, fast rung -> GEMMA_API_KEY + GEMMA3_MODEL
#   2. Gemini API, large rung -> GEMMA_API_KEY + GEMMA4_MODEL
#   3. Groq open-weight       -> GROQ_API_KEY + GROQ_MODEL
#   4. NVIDIA NIM             -> NVIDIA_API_KEY + NVIDIA_MODEL
# GEMMA_MODEL is honored as a fallback for GEMMA3_MODEL if set.
# NOTE (Oct 2026, from live provider errors): the Gemini API 404s Gemma 3
# IDs ("not found for API version"), while gemma-4-26b-a4b-it answers and
# gemma-4-31b-it is the documented sibling — hence the v4 defaults.
GEMMA3_MODEL=gemma-4-26b-a4b-it
GEMMA4_MODEL=gemma-4-31b-it
GROQ_API_KEY=
# gemma2-9b-it was retired by Groq; gpt-oss-120b (open-weight, 131K) is
# their recommended replacement and the working default.
GROQ_MODEL=openai/gpt-oss-120b
NVIDIA_API_KEY=
# meta/llama-3.1-8b-instruct was retired on NIM cloud (410 Gone,
# deprecated 2026-08-25), and google/gemma-2-9b-it 404s on the hosted
# endpoint — current build.nvidia.com chat IDs below (Oct 2026).
# Confirm yours first:
# curl $NVIDIA_BASE_URL/models -H "Authorization: Bearer $NVIDIA_API_KEY".
# On 404/410 the rung auto-switches to meta/llama-3.1-70b-instruct once.
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
